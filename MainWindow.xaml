<Window x:Class="FloatingTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating To-Do"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <!-- Flat icon-style button -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#88FFFFFF" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ===== Expanded list ===== -->
        <Border x:Name="PanelBorder" Width="300" CornerRadius="12" Background="#E61E1E1E" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: drag here to move the window -->
                <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource FlatButton}" Content="&#x2630;"
                            ToolTip="Shrink to bubble" Click="Shrink_Click"/>
                    <TextBlock Grid.Column="1" Text="To-do" Foreground="#CCFFFFFF" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False"/>
                    <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource FlatButton}"
                            Content="&#x2699;" ToolTip="Settings" Click="Settings_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource FlatButton}" Content="&#x2715;"
                            ToolTip="Close" Click="Close_Click"/>
                </Grid>

                <!-- Add row -->
                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewItemBox" Grid.Column="0" Height="32" Padding="8,0"
                             VerticalContentAlignment="Center" MaxLength="200"
                             Background="#26FFFFFF" Foreground="White" CaretBrush="White"
                             BorderBrush="#33FFFFFF" BorderThickness="1"
                             KeyDown="NewItemBox_KeyDown" TextChanged="NewItemBox_TextChanged"/>
                    <TextBlock x:Name="Hint" Grid.Column="0" Text="Add a task..." Foreground="#88FFFFFF"
                               VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="+" FontSize="22"
                            Margin="6,0,0,0" ToolTip="Add" Click="Add_Click"/>
                </Grid>

                <!-- Items -->
                <ScrollViewer x:Name="Scroller" Grid.Row="2" MaxHeight="300"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly"
                              PreviewMouseWheel="Scroller_PreviewMouseWheel">
                    <StackPanel>
                        <TextBlock x:Name="EmptyText" Text="Nothing to do. Add something above."
                                   Foreground="#88FFFFFF" Margin="4,6" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="ItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#22FFFFFF" CornerRadius="6" Padding="10,6">
                                            <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap"/>
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                                                Content="&#x1F5D1;" Margin="4,0,0,0" VerticalAlignment="Center"
                                                ToolTip="Delete" Click="Delete_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== Minimised bubble ===== -->
        <Border x:Name="BubbleBorder" Visibility="Collapsed" Width="46" Height="46" CornerRadius="23"
                Background="#E61E1E1E" Cursor="Hand" ToolTip="Click to expand, drag to move"
                MouseLeftButtonDown="Bubble_MouseDown" MouseMove="Bubble_MouseMove"
                MouseLeftButtonUp="Bubble_MouseUp">
            <TextBlock Text="&#x2630;" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Border>

        <!-- ===== Settings popup ===== -->
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Closed="SettingsPopup_Closed">
            <Border Background="#F0262626" CornerRadius="8" Padding="12" Margin="0,4,0,8"
                    BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel Width="200">
                    <CheckBox x:Name="TopmostCheck" Content="Always on top" Foreground="White"
                              Margin="0,0,0,8" Click="Topmost_Click"/>
                    <CheckBox x:Name="StartupCheck" Content="Start with Windows" Foreground="White"
                              Margin="0,0,0,8" Click="Startup_Click"/>
                    <TextBlock Text="Opacity" Foreground="#CCFFFFFF" Margin="0,0,0,2"/>
                    <Slider x:Name="OpacitySlider" Minimum="25" Maximum="100" ValueChanged="Opacity_Changed"/>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</Window>
